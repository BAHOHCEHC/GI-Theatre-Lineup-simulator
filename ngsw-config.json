{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",

  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/__/*",
    "!/__/auth/**",
    "!https://firebasestorage.googleapis.com/**",
    "!https://firestore.googleapis.com/**",
    "!https://*.firebaseio.com/**"
  ],

  "assetGroups": [
    {
      "name": "app",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
